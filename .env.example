# Modelo de configuração. Copie para .env e preencha.
#   cp .env.example .env
# O .env nunca é versionado nem servido por HTTP (ver .htaccess da raiz).

# Ambiente. APP_DEBUG=true expõe mensagens de exceção nas respostas e no HTML;
# deve ser false (ou ausente) em qualquer coisa que não seja a máquina de dev.
APP_DEBUG=false
APP_URL=http://localhost/plataform_stores/public

# Banco de dados. Em branco = os padrões do XAMPP em backend/config/database.php
# (localhost, plataform_stores, root, sem senha).
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Chave da API RapidAPI para geração de QR Code PIX (opcional).
# Sem ela, o QR é gerado pelo fallback em PixService.
RAPIDAPI_KEY=

# Chave da API OpenRouter para o assistente de IA do painel (opcional).
# Sem ela, o assistente responde "temporariamente indisponível".
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# Os slugs :free saem do catálogo da OpenRouter sem aviso. Se o assistente
# passar a responder "temporariamente indisponível" com erro 404, veja quais
# existem agora:
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_APP_NAME=TCC-Loja
OPENROUTER_SITE_URL=http://localhost
