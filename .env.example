# Modelo de configuração. Copie para .env e preencha.
#   cp .env.example .env
# O .env nunca é versionado nem servido por HTTP (ver .htaccess da raiz).

# Ambiente. APP_DEBUG=true expõe mensagens de exceção nas respostas e no HTML;
# deve ser false (ou ausente) em qualquer coisa que não seja a máquina de dev.
APP_DEBUG=false
APP_URL=http://localhost/plataform_stores/public

# Banco de dados. Em branco = os padrões do XAMPP em backend/config/database.php
# (localhost, plataform_stores, root, sem senha). Em branco aqui, uma variável
# de ambiente com o mesmo nome vale: DB_NAME=copia php backend/scripts/migrate.php
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Conjunto de caracteres da conexão (padrão utf8mb4).
# DB_CHARSET=utf8mb4

# Backup antes das migrations (backend/scripts/migrate.php). Só é preciso se o
# mysqldump não estiver em C:/xampp/mysql/bin, /usr/bin, /usr/local/bin nem no PATH.
# MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe

# Chave da API RapidAPI para geração de QR Code PIX (opcional).
# Sem ela, o QR é gerado pelo fallback em PixService.
RAPIDAPI_KEY=

# Assistente de IA do painel. Ordem de tentativa:
#   1. OpenRouter (se OPENROUTER_API_KEY estiver preenchida);
#   2. Groq (se GROQ_API_KEY estiver preenchida; a Groq não funciona sem chave,
#      mas a chave é grátis em console.groq.com);
#   3. Pollinations, que não pede chave nem cadastro. Garante que o assistente
#      responda mesmo sem nenhuma chave. IA_SEM_CHAVE=0 desliga.
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# Os slugs :free saem do catálogo da OpenRouter sem aviso. Se o assistente
# passar a responder "temporariamente indisponível" com erro 404, veja quais
# existem agora:
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_APP_NAME=TCC-Loja
OPENROUTER_SITE_URL=http://localhost

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
IA_SEM_CHAVE=1

# Opcionais do assistente de IA:
# Modelos reserva da OpenRouter, separados por vírgula (tentados quando o
# principal falha). OPENROUTER_DISABLE_MODEL_FALLBACK=1 desliga essa troca.
# Sem esta linha valem os padrões do código (AiAssistantService).
# OPENROUTER_MODEL_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
# OPENROUTER_DISABLE_MODEL_FALLBACK=0
# Erro de SSL (cURL #60) no XAMPP/Windows: caminho completo do cacert.pem.
# OPENROUTER_CURL_CAINFO=C:/xampp/php/extras/ssl/cacert.pem
# Endereço e modelo da Pollinations (provedor sem chave).
# POLLINATIONS_URL=https://text.pollinations.ai/openai
# POLLINATIONS_MODEL=openai

# Ferramentas de teste (backend/tools/authz_check.php e identity_check.php):
# domínio dos e-mails criados pelo seed.
# SEED_EMAIL_DOMAIN=loja.test
