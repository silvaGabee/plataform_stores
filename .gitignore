# Arquivo com chaves e senhas (não versionar).
# .env.example É versionado de propósito: é o modelo, sem segredos, que diz
# quais variáveis precisam existir para o projeto subir.
.env*
!.env.example

# Storage e cache
storage/logs/*
!storage/logs/.gitkeep
!storage/.gitkeep
storage/backups/*
!storage/backups/.gitkeep

# Composer: só ferramentas de desenvolvimento. A aplicação roda sem vendor/,
# e por isso ele não é versionado nem necessário no deploy.
/vendor/
composer.lock
.php-cs-fixer.cache
storage/backups/*
!storage/backups/.gitkeep
